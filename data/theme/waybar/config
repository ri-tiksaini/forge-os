{
  "layer": "top",
  "position": "bottom",
  "height": 42,
  "spacing": 6,
  "modules-left": [
    "custom/duck",
    "custom/term",
    "custom/editor",
    "custom/files",
    "custom/browser",
    "custom/settings"
  ],
  "modules-center": [
    "wlr/taskbar"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "network",
    "pulseaudio",
    "battery",
    "custom/clean",
    "custom/quick",
    "clock",
    "custom/power"
  ],
  "custom/duck": {
    "format": " \uf0c9 FORGE ",
    "tooltip": "Toggle Forge Apps (Win) | Right-click for Menu",
    "on-click": "forge-toggle launcher",
    "on-click-right": "forge-toggle menu"
  },
  "custom/term": {
    "format": " \uf120 Term ",
    "tooltip": "Open Terminal (foot)",
    "on-click": "foot"
  },
  "custom/editor": {
    "format": " \uf121 Code ",
    "tooltip": "Open Code Editor (Mousepad)",
    "on-click": "mousepad"
  },
  "custom/files": {
    "format": " \uf07b Files ",
    "tooltip": "Open File Manager (Thunar)",
    "on-click": "thunar"
  },
  "custom/browser": {
    "format": " \uf0ac Web ",
    "tooltip": "Open Browser (Firefox ESR)",
    "on-click": "firefox-esr"
  },
  "custom/settings": {
    "format": " \uf013 Settings ",
    "tooltip": "Open Forge Control Center",
    "on-click": "forge-settings"
  },
  "wlr/taskbar": {
    "format": "{icon} {title:.18}",
    "icon-size": 16,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "on-click-right": "minimize-raise"
  },
  "cpu": {
    "interval": 2,
    "format": "\uf2db {usage}%",
    "on-click": "foot -e /usr/local/bin/forge-hud"
  },
  "memory": {
    "interval": 2,
    "format": "\uf538 {percentage}%",
    "on-click": "forge-settings"
  },
  "network": {
    "interval": 2,
    "format-wifi": "\uf1eb \u2193{bandwidthDownBytes}",
    "format-ethernet": "\uf0e8 \u2193{bandwidthDownBytes}",
    "format-disconnected": "\uf127 OFF",
    "tooltip-format": "{ifname}: \u2193{bandwidthDownBytes} / \u2191{bandwidthUpBytes}",
    "on-click": "forge-toggle quick"
  },
  "pulseaudio": {
    "format": "\uf028 {volume}%",
    "format-muted": "\uf6a9 MUTE",
    "on-click": "forge-toggle quick",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "battery": {
    "format": "\uf240 {capacity}%",
    "format-charging": "\uf0e7 {capacity}%",
    "format-plugged": "\uf1e6 AC",
    "on-click": "forge-toggle quick"
  },
  "custom/quick": {
    "format": " \uf1de ",
    "tooltip": "Quick Settings: Volume, Brightness, Wi-Fi, Bluetooth (Win+A)",
    "on-click": "forge-toggle quick"
  },
  "clock": {
    "format": "\uf017 {:%H:%M}",
    "tooltip-format": "{:%Y-%m-%d %H:%M}",
    "on-click-right": "forge-toggle menu"
  },
  "custom/power": {
    "format": " \uf011 ",
    "tooltip": "Power Menu (Shutdown, Reboot, Suspend, Lock, Logout)",
    "on-click": "forge-toggle power"
  },
  "custom/clean": {
    "format": " \uf51a ",
    "tooltip": "Clean RAM & Dev Caches (sudo forge-clean)",
    "on-click": "foot -e sh -c 'sudo /usr/local/bin/forge-clean; sleep 2'"
  }
}
